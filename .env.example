ELIAPPLYBOT_DB_PATH=data/eliapplybot.sqlite3
ELIAPPLYBOT_BROWSER_PROFILE=playwright-profile
ELIAPPLYBOT_HEADLESS=false
# Optional: speech-to-text for dictating answer-bank entries (free key, no card:
# https://console.groq.com). Only audio you transcribe is sent to Groq.
GROQ_API_KEY=
ELIAPPLYBOT_STT_MODEL=whisper-large-v3-turbo

